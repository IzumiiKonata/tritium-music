#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Downloaded runtime assets, never convert them
*.onnx          binary
*.onnx.sha256   text eol=lf
*.ttf           binary
*.otf           binary
*.dll           binary
*.so            binary
*.dylib         binary

